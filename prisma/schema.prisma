generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique

  @@map("users")
}

model UserProfile {
  id         Int    @id @default(autoincrement())
  firstName  String @map("first_name")
  lastName   String @map("last_name")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("user_profile")
}
